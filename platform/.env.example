# --- Autenticazione (obbligatorie in produzione) ---
AUTH_SECRET=genera_con_openssl_rand_base64_32
ALLOWLIST_EMAILS=dirigente@example.com,staff@example.com
PLATFORM_PASSWORD=password_sicura_da_cambiare

# Password per singola email (opzionale, retrocompatibile con PLATFORM_PASSWORD)
# Formato: email:password,email2:password2
# Se l'email è elencata qui, viene verificata la password dedicata; altrimenti ALLOWLIST_EMAILS + PLATFORM_PASSWORD.
# ALLOWLIST_CREDENTIALS=dirigente@example.com:pass_dedicata,staff@example.com:altra_pass

# --- Database Neon / Postgres (opzionale in locale; cloud su Preview/Production) ---
# Fallback accettati da Drizzle e dal client: DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL
# Sincronizza da Vercel (nella cartella platform/):
#   npx vercel env pull .env.local
#   npm run db:push
# DATABASE_URL="postgresql://user:pass@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- News RSS — POST /api/news/scan (sessione richiesta, cache server 15 min) ---
# Se omesso: catalogo in src/lib/engine/newsFeedCatalog.ts (~31 feed: nazionali + ANSA 20 regioni + locali).
# NEWS_RSS_URLS=https://www.ansa.it/sito/notizie/politica/politica_rss.xml
# NEWS_KEYWORDS=dimissioni,passa a,elezioni comunali
# NEWS_SCAN_MAX_ITEMS=30

# --- Vercel AI Gateway (solo server-side) ---
# AI_GATEWAY_API_KEY=vck_...
# AI_GATEWAY_MODEL=openai/gpt-6-astra
