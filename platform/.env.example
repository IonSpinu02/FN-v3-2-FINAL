# --- Autenticazione (obbligatorie in produzione) ---
AUTH_SECRET=genera_con_openssl_rand_base64_32
ALLOWLIST_EMAILS=dirigente@example.com,staff@example.com
PLATFORM_PASSWORD=password_sicura_da_cambiare

# Password per singola email (opzionale, retrocompatibile con PLATFORM_PASSWORD)
# Formato: email:password,email2:password2
# Se l'email è elencata qui, viene verificata la password dedicata; altrimenti ALLOWLIST_EMAILS + PLATFORM_PASSWORD.
# ALLOWLIST_CREDENTIALS=dirigente@example.com:pass_dedicata,staff@example.com:altra_pass

# --- Database Neon / Postgres (opzionale in locale; cloud su Preview/Production) ---
# Fallback accettati da Drizzle e dal client: DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL
# Sincronizza da Vercel (nella cartella platform/):
#   npx vercel env pull .env.local
#   npm run db:push
# DATABASE_URL="postgresql://user:pass@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Tavily Search (opzionale — server-side, arricchisce radar news/Osservatorio) ---
# Non sostituisce verifica umana: tier MEDIA con link alla fonte (ANSA, Repubblica, …).
# TAVILY_API_KEY=tvly-...
# TAVILY_ENABLED=true
# TAVILY_MAX_RESULTS=8
# TAVILY_INCLUDE_DOMAINS=ansa.it,repubblica.it,ilsole24ore.com
# Budget crediti: al massimo UNA scansione Tavily al giorno (Europe/Rome) per modulo — reel virali,
# radar Osservatorio, cambi di partito, scanner Locali, previsione crescita. Il resto della giornata
# riusa i dati salvati (RAM → .cache/tavily-daily-cache.json o /tmp su Vercel → tabella Postgres
# tavily_daily_cache). Google News, ANSA e i ~31 feed RSS restano live (sono gratuiti).
# TAVILY_DAILY_CACHE_FILE=/percorso/tavily-daily-cache.json   # default .cache/ (in locale) o /tmp
# Bypass amministrativo del limite giornaliero (sconsigliato in produzione):
# ALLOW_TAVILY_FORCE_REFRESH=true    # abilita il pulsante «Forza nuova scansione» per tutti
# TAVILY_FORCE_REFRESH_SECRET=...    # oppure: richiesta con header x-tavily-force-secret + ?force=1

# --- Cron / machine auth (obbligatorio in produzione) ---
# Vercel Cron invia Authorization: Bearer <secret> se CRON_SECRET è impostato nel progetto.
# CRON_SECRET=genera_stringa_lunga_casuale
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # opzionale, da system-monitor
# ALERT_WEBHOOK_COOLDOWN_MS=3600000
# Dev locale: FN_AUTH_DEV_BYPASS=1  # SOLO con NODE_ENV=development, mai in preview/prod

# --- Consenso nazionale live (default: S live attivo in dashboard, refresh ~60s) ---
# Cron Vercel: GET /api/consenso/sync (vercel.json, 05:00 UTC) + CRON_SECRET in prod

# --- News RSS — POST /api/news/scan (sessione richiesta, cache server 15 min) ---
# Se omesso: catalogo in src/lib/engine/newsFeedCatalog.ts (~31 feed: nazionali + ANSA 20 regioni + locali).
# NEWS_RSS_URLS=https://www.ansa.it/sito/notizie/politica/politica_rss.xml
# NEWS_KEYWORDS=dimissioni,passa a,elezioni comunali
# NEWS_SCAN_MAX_ITEMS=30

# --- Vercel AI Gateway (solo server-side) ---
# AI_GATEWAY_API_KEY=vck_...
# AI_GATEWAY_MODEL=openai/gpt-6-astra

# --- Anthropic (Claude + Web Search per /api/forecast-intelligence) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Roadmap AI in /app/obiettivo (POST /api/strategy/generate-roadmap) ---
# Modello primario: Claude Sonnet 5.5 via ANTHROPIC_API_KEY (+ ANTHROPIC_MODEL).
# Fallback opzionali: OPENAI_API_KEY, GEMINI_API_KEY.
# Se nessuna chiave è presente, l'endpoint usa il motore combinatorio deterministico.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=sk-...
# OPENAI_ROADMAP_MODEL=gpt-4o-mini
# GEMINI_API_KEY=...
# GEMINI_ROADMAP_MODEL=gemini-2.5-flash
