AUTH_SECRET=genera_con_openssl_rand_base64_32
ALLOWLIST_EMAILS=dirigente@example.com,staff@example.com
PLATFORM_PASSWORD=password_sicura_da_cambiare

# News RSS (MVP rule-based) — POST /api/news/scan (sessione richiesta)
# Se omesso: catalogo in src/lib/engine/newsFeedCatalog.ts (8 nazionali + ANSA 20 regioni + 3 locali).
# Imposta NEWS_RSS_URLS solo per override (es. scan più veloce con pochi feed).
# NEWS_RSS_URLS=https://www.ansa.it/sito/notizie/politica/politica_rss.xml,https://www.agi.it/politica/rss
# Condizioni d’uso editore (es. ANSA RSS non commerciale): https://www.ansa.it/sito/static/ansa_rss.html
# Opzionale: parole chiave aggiuntive (virgola). Default interno: sindaco, giunta, consiglio, …
# NEWS_KEYWORDS=dimissioni,passa a,elezioni comunali
NEWS_SCAN_MAX_ITEMS=30

# Neon (Vercel Storage) — Preview + Production via integrazione Vercel
# In locale: copia DATABASE_URL da Vercel oppure vercel env pull (Preview/Production).
# DATABASE_URL=postgresql://...
# Dopo la prima connessione: npm run db:schema (o incolla db/schema.sql nel SQL Editor Neon)
