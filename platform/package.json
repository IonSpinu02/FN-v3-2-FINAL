{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:metodologia-pdf": "npx --yes md-to-pdf docs/METODOLOGIA-NUMERI-E-SIMULAZIONI.md --stylesheet docs/metodologia-pdf.css && node -e \"require('fs').copyFileSync('docs/METODOLOGIA-NUMERI-E-SIMULAZIONI.pdf','public/METODOLOGIA-NUMERI-E-SIMULAZIONI-FN-v3-2.pdf')\"",
    "docs:vannacci-pdf": "npx --yes md-to-pdf docs/PRESENTAZIONE-VANNACCI-PIATTAFORMA.md --stylesheet docs/metodologia-pdf.css && node -e \"require('fs').copyFileSync('docs/PRESENTAZIONE-VANNACCI-PIATTAFORMA.pdf','public/PRESENTAZIONE-VANNACCI-PIATTAFORMA-FN-v3-2.pdf')\"",
    "docs:presentazione-pdf": "npx --yes md-to-pdf docs/PRESENTAZIONE-PIATTAFORMA-FN-v3-2.md --stylesheet docs/metodologia-pdf.css && node -e \"require('fs').copyFileSync('docs/PRESENTAZIONE-PIATTAFORMA-FN-v3-2.pdf','public/PRESENTAZIONE-PIATTAFORMA-FN-v3-2.pdf')\"",
    "docs:presentazione-tecnica-pdf": "npx --yes md-to-pdf docs/PRESENTAZIONE-TECNICA-FN-v3-2.md --stylesheet docs/metodologia-pdf.css && node -e \"require('fs').copyFileSync('docs/PRESENTAZIONE-TECNICA-FN-v3-2.pdf','public/PRESENTAZIONE-TECNICA-FN-v3-2.pdf')\"",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "db:schema": "node scripts/apply-neon-schema.mjs",
    "db:push": "node scripts/db-push-safe.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@fontsource/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "ai": "^7.0.146",
    "d3-scale": "^4.0.2",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "python-random": "^1.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-simple-maps": "^5.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/turbopack": "^4",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^64.5.0",
    "vitest": "^2.1.9"
  }
}
